{
  "name": "prompt-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Join a room with friends, prompt a game together, play it instantly.",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "smoke": "node test/smoke.mjs",
    "gen": "node test/gen-once.mjs",
    "playtest": "node test/playtest.mjs",
    "typecheck": "tsc --noEmit",
    "twobrowser": "node test/twobrowser.mjs",
    "verify-check": "node test/verify-check.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}