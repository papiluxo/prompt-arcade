# Prompt Arcade config — copy to .env and edit as needed.

# Port for the realtime + API server
PORT=8787

# Generation backend:
#   cli — shells out to the local `claude` CLI (uses your Claude subscription, no API key)
#   api — calls the Anthropic Messages API (requires ANTHROPIC_API_KEY)
GEN_BACKEND=cli

# Only needed when GEN_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-...

# Where saved games live
# DATA_DIR=./data

# Max seconds a single model gets to write a game. Deliberately generous —
# players can cancel from the room whenever they lose patience.
GEN_TIMEOUT_SEC=900
